{
  "manifest_version": 3,
  "name": "ChatGPT Folder Bridge",
  "version": "0.4.0",
  "description": "Routes uploads and downloads by ChatGPT project, safely survives extension updates, and optionally downloads the last matching result after reload.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Folder Bridge",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
